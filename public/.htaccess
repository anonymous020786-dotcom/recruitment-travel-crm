# =============================================================================
# public/ is the ONLY web-exposed directory. Point the domain's document root
# here. If the host will not let you move the docroot, see ../.htaccess.
# =============================================================================

# ---- HTTPS + HSTS handled in PHP; force here as a safety net -----------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (skip if already terminated at a proxy that sets X-Forwarded-Proto)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Front controller: send everything that is not a real file/dir to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# ---- No directory listings, no dotfiles -----------------------------------
Options -Indexes -MultiViews
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ---- Never execute anything but index.php as PHP in this dir --------------
<FilesMatch "\.(?i:php)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>

# ---- Long-lived caching for versioned static assets -----------------------
<IfModule mod_headers.c>
    # The content-hashed build files (app.<hash>.css/js, and their .br/.gz copies) never change under the same name.
    <FilesMatch "^app\.[0-9a-f]{10}\.(?i:css|js)(\.br|\.gz)?$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Everything else (images, fonts…) keeps its name when replaced, so cache it for a month, not forever.
    <FilesMatch "\.(?i:woff2?|png|jpe?g|webp|avif|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # Baseline headers (PHP layer sets the authoritative, per-group values)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    # Don't advertise the PHP version.
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Pre-compressed assets ---------------------------------------------------
# `npm run build` writes app.<hash>.css/js next to .br (Brotli, level 11) and .gz (gzip, level 9) copies. When the browser
# accepts the encoding and the copy exists, serve it as-is: smaller than on-the-fly compression and no CPU per request.
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP:Accept-Encoding} \bbr\b
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.+)\.(css|js)$ $1.$2.br [L,E=SERVE_BR:1]

    RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(.+)\.(css|js)$ $1.$2.gz [L,E=SERVE_GZ:1]
</IfModule>
<IfModule mod_mime.c>
    <FilesMatch "\.css\.(br|gz)$">
        ForceType text/css
    </FilesMatch>
    <FilesMatch "\.js\.(br|gz)$">
        ForceType application/javascript
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    Header set Content-Encoding br env=SERVE_BR
    Header set Content-Encoding gzip env=SERVE_GZ
    Header append Vary Accept-Encoding env=SERVE_BR
    Header append Vary Accept-Encoding env=SERVE_GZ
</IfModule>

# ---- Block hidden/backup/source files that should never be served ---------
<FilesMatch "(?i:\.(bak|config|sql|sqlite|db|log|ini|sh|md|lock|dist|yml|yaml))$">
    Require all denied
</FilesMatch>
