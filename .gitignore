# Environment / secrets
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/

# Test / tool caches
/.phpunit.cache/
/.phpunit.result.cache

# Built assets: the hashed files + manifest are COMMITTED so shared hosts
# without Node can deploy. The intermediate un-hashed app.css is not.
/public/assets/build/app.css

# Runtime storage (keep the directories, ignore the contents)
/storage/logs/*
/storage/cache/*
/storage/exports/*
/storage/imports/*
/storage/private/*
/storage/framework/*
!/storage/**/.gitkeep

# Local backups
/storage/private/backups/*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
