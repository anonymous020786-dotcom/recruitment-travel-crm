# Environment / secrets
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/

# Built assets: COMMITTED so shared hosts without Node can deploy.
# Regenerate with `npm run build`.
!/public/assets/build/

# Runtime storage (keep the directories, ignore the contents)
/storage/logs/*
/storage/cache/*
/storage/exports/*
/storage/imports/*
/storage/private/*
/storage/framework/*
!/storage/**/.gitkeep

# Local backups
/storage/private/backups/*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
