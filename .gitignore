# Environment / secrets
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/

# Test / tool caches
/.phpunit.cache/
/.phpunit.result.cache

# Built assets: the hashed files + manifest are COMMITTED so shared hosts
# without Node can deploy. The intermediate un-hashed app.css is not.
/public/assets/build/app.css

# Runtime storage (keep the directories + their .htaccess guards, ignore the
# contents). A bare `/storage/private/*` ignores storage/private/documents and
# storage/private/backups as opaque directory entries — git then never
# descends into them, so a later `!/storage/**/.gitkeep` can't reach anything
# inside (the exact gap Step 2.7 fixed for storage/private/.htaccess itself).
# Un-ignore the two subdirectories explicitly, then re-ignore their real
# contents one level deeper so uploaded/backup files still never get tracked.
/storage/logs/*
/storage/cache/*
/storage/exports/*
/storage/imports/*
/storage/private/*
/storage/framework/*
!/storage/private/documents/
!/storage/private/backups/
/storage/private/documents/**
/storage/private/backups/**
!/storage/**/.gitkeep
!/storage/**/.htaccess

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
bootstrap/cache/*
!bootstrap/cache/.gitkeep

# Personal Claude Code settings (not shared with the team)
.claude/settings.local.json

# Media library uploads (keep the folder guard)
/public/media/*
!/public/media/.htaccess
