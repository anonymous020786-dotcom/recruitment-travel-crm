# =============================================================================
# Copy to .env and fill in. NEVER commit .env. chmod 600 .env on the server.
# .env must live outside the web root (or be denied by .htaccess).
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME="Recruitment & Travel CRM"
APP_ENV=production            # local | staging | production
APP_DEBUG=false               # MUST be false in production
APP_URL=https://crm.example.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# 32-byte base64 key for cookie/CSRF/token signing. Generate with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# ---- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uXXXX_crm
DB_USER=uXXXX_crm
DB_PASSWORD=

# ---- Session --------------------------------------------------------------
SESSION_DRIVER=database        # database (default) | file
SESSION_COOKIE=crm_session
SESSION_LIFETIME_MINUTES=480   # absolute lifetime
SESSION_IDLE_MINUTES=30        # idle timeout
SESSION_SECURE=true            # true in production (HTTPS)
SESSION_SAME_SITE=Lax

# ---- Security ------------------------------------------------------------
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
TRUSTED_PROXIES=               # comma list, if behind a proxy/CDN

# ---- Mail ----------------------------------------------------------------
MAIL_DRIVER=smtp               # smtp | log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl            # ssl | tls | none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Recruitment & Travel CRM"

# ---- Cron --------------------------------------------------------------
# Shared secret required as arg 1 when a cron script is run: php cron/x.php $CRON_SECRET
CRON_SECRET=

# ---- Uploads --------------------------------------------------------------
UPLOAD_MAX_KB=12288            # 12 MB app-side cap (keep php.ini in sync)
UPLOAD_DISK=private

# ---- Public site / SEO --------------------------------------------------
SEO_DEFAULT_TITLE="Overseas Jobs, Recruitment & Travel"
SEO_DEFAULT_DESCRIPTION="Overseas employment, recruitment and travel services."
SEO_ORG_NAME="Your Agency Pvt Ltd"

# ---- Integrations (public site only) -----------------------------------
INTEGRATIONS_WHATSAPP_NUMBER=          # e.g. 919812345678 (digits only, with country code)
INTEGRATIONS_WHATSAPP_TEXT="Hi, I would like to know more about your services."
INTEGRATIONS_WHATSAPP_BUTTON=true
INTEGRATIONS_GA4_ID=                   # e.g. G-XXXXXXXXXX
INTEGRATIONS_ANALYTICS_CONSENT=true
INTEGRATIONS_TURNSTILE_SITE_KEY=
INTEGRATIONS_TURNSTILE_SECRET_KEY=
INTEGRATIONS_TAWK_PROPERTY_ID=
INTEGRATIONS_TAWK_WIDGET_ID=default

# ---- Two-factor authentication ---------------------------------------
TWO_FACTOR_ISSUER=                     # defaults to APP_NAME
TWO_FACTOR_REQUIRED_ROLES=             # comma list, e.g. super_admin,admin

# ---- Passkeys / WebAuthn --------------------------------------------
WEBAUTHN_RP_ID=                        # defaults to the APP_URL host
WEBAUTHN_RP_NAME=                      # defaults to APP_NAME
WEBAUTHN_ORIGINS=                      # comma list; defaults to APP_URL (scheme+host+port, no trailing slash)
WEBAUTHN_USER_VERIFICATION=preferred   # required | preferred | discouraged
WEBAUTHN_PASSWORDLESS=true             # allow passkey-only sign-in (no password)
